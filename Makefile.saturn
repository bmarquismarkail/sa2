include config.mk

MAKEFLAGS += --no-print-directory
.SECONDARY:

ROOT_DIR := "$(shell dirname "$(realpath $(firstword $(MAKEFILE_LIST)))")"
SATURN_MINIMAL_BOOT ?= 0
SATURN_PLATFORM_PROBE ?= 0
SATURN_ENTRY_PROBE ?= 0
SATURN_PLATFORM_INIT_PROBE ?= 0
SATURN_PLATFORM_ONLY_PROBE ?= 0
SATURN_PLATFORM_CALLBACK_PROBE ?= 0
SATURN_PLATFORM_VBLANK_PROBE ?= 0
SATURN_PLATFORM_SPRITE_PROBE ?= 0
SATURN_PLATFORM_STATIC_SPRITE_PROBE ?= 0
SATURN_PLATFORM_SKIP_INIT_PROBE ?= 0
SATURN_PLATFORM_SKIP_PREPARE_PROBE ?= 0
SATURN_PLATFORM_SLIM_PROBE ?= 0
SATURN_PLATFORM_MEMORY_PROBE ?=
SATURN_FULL_LINK_PROBE ?= 0
SATURN_FULL_LINK_PROBE_EXCLUDE ?=
SATURN_STAGE2_ONLY ?= 0
SATURN_STAGE2_FILE ?= SA2STAGE.BIN
SATURN_STAGE2_GAME_ONLY ?= 0
SATURN_STAGE2_GAME_FILE ?= SA2GAME.BIN
SATURN_STAGE2_LOAD_ADDRESS ?= 0x00220000
SATURN_STAGE2_GAME_LOAD_ADDRESS ?= 0x00280000
SATURN_STAGE2_PROFILE ?= engine-init
SATURN_STAGE2_SHELL ?= 0
SATURN_STAGE1_LOADER ?= 0
SATURN_BOOTABLE_DEFAULT ?= 1
SATURN_BOOT_RAW_MAX_BYTES ?= 983040

ifeq ($(SATURN_BOOTABLE_DEFAULT),1)
ifeq ($(filter 1,$(SATURN_MINIMAL_BOOT) $(SATURN_PLATFORM_PROBE) $(SATURN_ENTRY_PROBE) $(SATURN_PLATFORM_INIT_PROBE) $(SATURN_PLATFORM_ONLY_PROBE) $(SATURN_PLATFORM_CALLBACK_PROBE) $(SATURN_PLATFORM_VBLANK_PROBE) $(SATURN_PLATFORM_SPRITE_PROBE) $(SATURN_PLATFORM_STATIC_SPRITE_PROBE) $(SATURN_PLATFORM_SKIP_INIT_PROBE) $(SATURN_PLATFORM_SKIP_PREPARE_PROBE) $(SATURN_PLATFORM_SLIM_PROBE) $(SATURN_FULL_LINK_PROBE) $(SATURN_STAGE2_ONLY)),)
ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),)
# Default to a small bootable bring-up image on real Saturn hardware until staged CD loading exists.
SATURN_FULL_LINK_PROBE := 1
SATURN_FULL_LINK_PROBE_EXCLUDE := content-core
endif
endif
endif

ifeq ($(SATURN_FULL_LINK_PROBE),1)
ifeq ($(SATURN_FULL_LINK_PROBE_EXCLUDE),content-core)
SATURN_STAGE1_LOADER := 1
endif
endif
ifneq ($(SATURN_PLATFORM_MEMORY_PROBE),)
BUILD_NAME := sa2-platform-memory-$(SATURN_PLATFORM_MEMORY_PROBE)-probe
else ifeq ($(SATURN_STAGE2_GAME_ONLY),1)
BUILD_NAME := sa2-stage2-game
else ifeq ($(SATURN_STAGE2_ONLY),1)
BUILD_NAME := sa2-stage2
else ifeq ($(SATURN_FULL_LINK_PROBE),1)
ifeq ($(SATURN_FULL_LINK_PROBE_EXCLUDE),)
BUILD_NAME := sa2-full-link-probe
else
BUILD_NAME := sa2-full-link-probe-minus-$(SATURN_FULL_LINK_PROBE_EXCLUDE)
endif
else ifeq ($(SATURN_PLATFORM_SLIM_PROBE),1)
BUILD_NAME := sa2-platform-slim-probe
else ifeq ($(SATURN_PLATFORM_SKIP_PREPARE_PROBE),1)
BUILD_NAME := sa2-platform-skip-prepare-probe
else ifeq ($(SATURN_PLATFORM_SKIP_INIT_PROBE),1)
BUILD_NAME := sa2-platform-skip-init-probe
else ifeq ($(SATURN_PLATFORM_STATIC_SPRITE_PROBE),1)
BUILD_NAME := sa2-platform-static-sprite-probe
else ifeq ($(SATURN_PLATFORM_SPRITE_PROBE),1)
BUILD_NAME := sa2-platform-sprite-probe
else ifeq ($(SATURN_PLATFORM_VBLANK_PROBE),1)
BUILD_NAME := sa2-platform-vblank-probe
else ifeq ($(SATURN_PLATFORM_CALLBACK_PROBE),1)
BUILD_NAME := sa2-platform-callback-probe
else ifeq ($(SATURN_PLATFORM_ONLY_PROBE),1)
BUILD_NAME := sa2-platform-only-probe
else ifeq ($(SATURN_PLATFORM_INIT_PROBE),1)
BUILD_NAME := sa2-platform-init-probe
else ifeq ($(SATURN_ENTRY_PROBE),1)
BUILD_NAME := sa2-entry-probe
else ifeq ($(SATURN_PLATFORM_PROBE),1)
BUILD_NAME := sa2-platform-probe
else ifeq ($(SATURN_MINIMAL_BOOT),1)
BUILD_NAME := sa2-minimal
else
BUILD_NAME := sa2
endif
PLATFORM := saturn
CPU_ARCH := sh2
# Override JOENGINE_ROOT=/path/to/joengine if your local Jo Engine checkout lives elsewhere.
JOENGINE_ROOT ?= /home/brandon/src/repos/joengine
# Default to entering the game directly; set SATURN_BOOT_TRAP=1 when doing early boot diagnostics.
SATURN_BOOT_TRAP ?= 0
ifeq ($(wildcard $(JOENGINE_ROOT)),)
$(error JOENGINE_ROOT directory '$(JOENGINE_ROOT)' was not found. Set JOENGINE_ROOT=/path/to/joengine when invoking make or export JOENGINE_ROOT in your environment)
endif
JOENGINE_COMPILER := $(JOENGINE_ROOT)/Compiler
JOENGINE_SRC := $(JOENGINE_ROOT)/jo_engine
JOENGINE_SGL := $(JOENGINE_COMPILER)/COMMON/SGL_302j
JOENGINE_SGL_INC := $(JOENGINE_SGL)/INC
JOENGINE_SGL_LIB := $(JOENGINE_SGL)/LIB_ELF

CC := $(JOENGINE_COMPILER)/LINUX/bin/sh-none-elf-gcc-8.2.0
CXX := $(CC)
OBJCOPY := $(JOENGINE_COMPILER)/LINUX/bin/sh-none-elf-objcopy
CPP := $(CC) -E

GFX := tools/gbagfx/gbagfx$(EXE)
ENT_POS := tools/entity_positions/entity_positions$(EXE)
AIF := tools/aif2pcm/aif2pcm$(EXE)
SCANINC := tools/scaninc/scaninc$(EXE)
PREPROC := tools/preproc/preproc$(EXE)

OUT_DIR := build/saturn/$(BUILD_NAME)
OBJ_DIR := $(OUT_DIR)/obj
DISC_DIR := $(OUT_DIR)/disc
CD_DIR := $(DISC_DIR)/cd

TARGET := $(OUT_DIR)/$(BUILD_NAME).saturn.elf
RAW := $(OUT_DIR)/$(BUILD_NAME).saturn.raw
MAP := $(OUT_DIR)/$(BUILD_NAME).saturn.map
ISO := $(OUT_DIR)/$(BUILD_NAME).iso
CUE := $(OUT_DIR)/$(BUILD_NAME).cue
ENTRY := $(DISC_DIR)/1ST_READ.BIN
CD_ENTRY := $(CD_DIR)/0.bin
IPFILE := $(DISC_DIR)/IP.BIN
ABSFILE := $(CD_DIR)/ABS.TXT
BIBFILE := $(CD_DIR)/BIB.TXT
CPYFILE := $(CD_DIR)/CPY.TXT
SATURN_STAGE2_NAME := sa2-stage2
SATURN_STAGE2_RAW := build/saturn/$(SATURN_STAGE2_NAME)/$(SATURN_STAGE2_NAME).saturn.raw
SATURN_STAGE2_CD_FILE := $(CD_DIR)/$(SATURN_STAGE2_FILE)
SATURN_STAGE2_GAME_NAME := sa2-stage2-game
SATURN_STAGE2_GAME_RAW := build/saturn/$(SATURN_STAGE2_GAME_NAME)/$(SATURN_STAGE2_GAME_NAME).saturn.raw
SATURN_STAGE2_GAME_CD_FILE := $(CD_DIR)/$(SATURN_STAGE2_GAME_FILE)
EXTRA_CD_FILES :=
ifeq ($(SATURN_STAGE2_ONLY),0)
ifeq ($(SATURN_FULL_LINK_PROBE),1)
ifeq ($(SATURN_FULL_LINK_PROBE_EXCLUDE),content-core)
EXTRA_CD_FILES += $(SATURN_STAGE2_CD_FILE) $(SATURN_STAGE2_GAME_CD_FILE)
endif
endif
endif
ifeq ($(SATURN_STAGE2_ONLY),1)
LINKER_SCRIPT := $(ROOT_DIR)/src/platform/saturn/stage2.linker
else
LINKER_SCRIPT := $(JOENGINE_COMPILER)/COMMON/sgl.linker
endif
CUE_MAKER := "$(JOENGINE_COMPILER)/LINUX/Other Utilities/CueMaker"
MKISOFS := mkisofs
SATURN_DISC_NAME := SA2

ifeq ($(wildcard $(JOENGINE_COMPILER)/COMMON/IP.BIN),)
$(error Jo Engine IP.BIN was not found at '$(JOENGINE_COMPILER)/COMMON/IP.BIN')
endif
ifeq ($(shell test -x "$(JOENGINE_COMPILER)/LINUX/Other Utilities/CueMaker" && printf yes),)
$(error Jo Engine CueMaker was not found at '$(JOENGINE_COMPILER)/LINUX/Other Utilities/CueMaker')
endif
ifeq ($(shell command -v $(MKISOFS) 2>/dev/null),)
$(error mkisofs was not found in PATH. Install it before building the Saturn disc image)
endif

MKISOFS_FLAGS := -quiet \
	-sysid "SEGA SATURN" \
	-volid "$(SATURN_DISC_NAME)" \
	-volset "$(SATURN_DISC_NAME)" \
	-sectype 2352 \
	-publisher "SEGA ENTERPRISES, LTD." \
	-preparer "SEGA ENTERPRISES, LTD." \
	-appid "$(SATURN_DISC_NAME)" \
	-abstract "disc/cd/ABS.TXT" \
	-copyright "disc/cd/CPY.TXT" \
	-biblio "disc/cd/BIB.TXT" \
	-generic-boot "disc/IP.BIN" \
	-full-iso9660-filenames \
	-o "$(BUILD_NAME).iso" \
	"disc/cd"

INCLUDE_DIRS := include
INCLUDE_CPP_ARGS := $(INCLUDE_DIRS:%=-iquote %)
INCLUDE_SCANINC_ARGS := $(INCLUDE_DIRS:%=-I %)

CPPFLAGS := $(INCLUDE_CPP_ARGS) \
	-D $(GAME_REGION) \
	-I$(JOENGINE_SRC) \
	-I$(JOENGINE_SGL_INC) \
	-I$(JOENGINE_COMPILER)/WINDOWS/sh-elf/include \
	-DPLATFORM_GBA=0 \
	-DPLATFORM_SDL=0 \
	-DPLATFORM_WIN32=0 \
	-DPLATFORM_SATURN=1 \
	-DCPU_ARCH_X86=0 \
	-DCPU_ARCH_ARM=0 \
	-DCPU_ARCH_SH2=1 \
	-DPORTABLE=1 \
	-DNON_MATCHING=1 \
	-DENABLE_DECOMP_CREDITS=1 \
	-DDEBUG=0 \
	-DHEADLESS=0 \
	-DJO_FRAMERATE=1 \
	-DJO_MAX_SPRITE=255 \
	-DJO_MAX_SPRITE_ANIM=16 \
	-DJO_GLOBAL_MEMORY_SIZE_FOR_MALLOC=393216 \
	-DJO_MAX_FILE_IN_IMAGE_PACK=32 \
	-DJO_MAP_MAX_LAYER=8 \
	-DJO_MAX_FS_BACKGROUND_JOBS=1 \
	-DJO_NTSC_VERSION \
	-DJO_COMPILE_USING_SGL \
	-DJO_COMPILE_WITH_PRINTF_SUPPORT \
	-DJO_COMPILE_WITH_3D_SUPPORT \
	-DJO_COMPILE_WITH_FS_SUPPORT \
	-DJO_COMPILE_WITH_BACKUP_SUPPORT \
	-DSATURN_BOOT_TRAP=$(SATURN_BOOT_TRAP) \
	-DSATURN_STAGE1_LOADER=$(SATURN_STAGE1_LOADER) \
	-DSATURN_STAGE2_ONLY=$(SATURN_STAGE2_ONLY) \
	-DSATURN_STAGE2_GAME_ONLY=$(SATURN_STAGE2_GAME_ONLY) \
	-DSATURN_STAGE2_SHELL=$(SATURN_STAGE2_SHELL) \
	-DSATURN_STAGE2_LOAD_ADDRESS=$(SATURN_STAGE2_LOAD_ADDRESS) \
	-DSATURN_STAGE2_FILE='"$(SATURN_STAGE2_FILE)"' \
	-DSATURN_STAGE2_GAME_FILE='"$(SATURN_STAGE2_GAME_FILE)"' \
	-DSATURN_STAGE2_GAME_LOAD_ADDRESS=$(SATURN_STAGE2_GAME_LOAD_ADDRESS) \
	-DSATURN_GAME_FILE='"$(SATURN_STAGE2_GAME_FILE)"'

ifneq ($(filter 1,$(SATURN_PLATFORM_PROBE) $(SATURN_ENTRY_PROBE) $(SATURN_PLATFORM_INIT_PROBE) $(SATURN_PLATFORM_ONLY_PROBE) $(SATURN_PLATFORM_CALLBACK_PROBE) $(SATURN_PLATFORM_VBLANK_PROBE) $(SATURN_PLATFORM_SPRITE_PROBE) $(SATURN_PLATFORM_STATIC_SPRITE_PROBE) $(SATURN_FULL_LINK_PROBE) $(SATURN_STAGE2_ONLY) $(SATURN_STAGE2_GAME_ONLY)),)
CPPFLAGS += -DSATURN_PROBE_VISUALS=1
else
CPPFLAGS += -DSATURN_PROBE_VISUALS=0
endif

ifneq ($(filter 1,$(SATURN_PLATFORM_SPRITE_PROBE)),)
CPPFLAGS += -DSATURN_PROBE_SPRITE_PRESENT=1
else
CPPFLAGS += -DSATURN_PROBE_SPRITE_PRESENT=0
endif

ifneq ($(filter 1,$(SATURN_PLATFORM_SLIM_PROBE)),)
CPPFLAGS += -DSATURN_PROBE_SLIM_PLATFORM=1
else
CPPFLAGS += -DSATURN_PROBE_SLIM_PLATFORM=0
endif

ifneq ($(SATURN_PLATFORM_MEMORY_PROBE),)
ifeq ($(filter 1,$(SATURN_PLATFORM_SLIM_PROBE)),)
CPPFLAGS += -DSATURN_PROBE_SLIM_PLATFORM=1
endif
endif

ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),regs)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=1 -DSATURN_MEMORY_PROBE_IWRAM=0 -DSATURN_MEMORY_PROBE_EWRAM=0 -DSATURN_MEMORY_PROBE_VIDEO=0 -DSATURN_MEMORY_PROBE_FLASH=0
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),iwram)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=0 -DSATURN_MEMORY_PROBE_IWRAM=1 -DSATURN_MEMORY_PROBE_EWRAM=0 -DSATURN_MEMORY_PROBE_VIDEO=0 -DSATURN_MEMORY_PROBE_FLASH=0
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),ewram)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=0 -DSATURN_MEMORY_PROBE_IWRAM=0 -DSATURN_MEMORY_PROBE_EWRAM=1 -DSATURN_MEMORY_PROBE_VIDEO=0 -DSATURN_MEMORY_PROBE_FLASH=0
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),video)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=0 -DSATURN_MEMORY_PROBE_IWRAM=0 -DSATURN_MEMORY_PROBE_EWRAM=0 -DSATURN_MEMORY_PROBE_VIDEO=1 -DSATURN_MEMORY_PROBE_FLASH=0
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),flash)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=0 -DSATURN_MEMORY_PROBE_IWRAM=0 -DSATURN_MEMORY_PROBE_EWRAM=0 -DSATURN_MEMORY_PROBE_VIDEO=0 -DSATURN_MEMORY_PROBE_FLASH=1
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),common-core)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=1 -DSATURN_MEMORY_PROBE_IWRAM=1 -DSATURN_MEMORY_PROBE_EWRAM=1 -DSATURN_MEMORY_PROBE_VIDEO=0 -DSATURN_MEMORY_PROBE_FLASH=0
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),common-video)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=1 -DSATURN_MEMORY_PROBE_IWRAM=1 -DSATURN_MEMORY_PROBE_EWRAM=1 -DSATURN_MEMORY_PROBE_VIDEO=1 -DSATURN_MEMORY_PROBE_FLASH=0
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),common-flash)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=1 -DSATURN_MEMORY_PROBE_IWRAM=1 -DSATURN_MEMORY_PROBE_EWRAM=1 -DSATURN_MEMORY_PROBE_VIDEO=0 -DSATURN_MEMORY_PROBE_FLASH=1
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),common)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=1 -DSATURN_MEMORY_PROBE_IWRAM=1 -DSATURN_MEMORY_PROBE_EWRAM=1 -DSATURN_MEMORY_PROBE_VIDEO=1 -DSATURN_MEMORY_PROBE_FLASH=1
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),common-core-pad)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=1 -DSATURN_MEMORY_PROBE_IWRAM=1 -DSATURN_MEMORY_PROBE_EWRAM=1 -DSATURN_MEMORY_PROBE_VIDEO=0 -DSATURN_MEMORY_PROBE_FLASH=0 -DSATURN_MEMORY_PROBE_PAD_VIDEO_SHIFT=1
else ifeq ($(SATURN_PLATFORM_MEMORY_PROBE),common-flash-pad)
CPPFLAGS += -DSATURN_MEMORY_PROBE_REGS=1 -DSATURN_MEMORY_PROBE_IWRAM=1 -DSATURN_MEMORY_PROBE_EWRAM=1 -DSATURN_MEMORY_PROBE_VIDEO=0 -DSATURN_MEMORY_PROBE_FLASH=1 -DSATURN_MEMORY_PROBE_PAD_VIDEO_SHIFT=1
else ifneq ($(SATURN_PLATFORM_MEMORY_PROBE),)
$(error Unsupported SATURN_PLATFORM_MEMORY_PROBE='$(SATURN_PLATFORM_MEMORY_PROBE)'; expected regs, iwram, ewram, video, flash, common-core, common-video, common-flash, common, common-core-pad, or common-flash-pad)
endif

ifeq ($(findstring -DSATURN_MEMORY_PROBE_PAD_VIDEO_SHIFT=1,$(CPPFLAGS)),-DSATURN_MEMORY_PROBE_PAD_VIDEO_SHIFT=1)
else
CPPFLAGS += -DSATURN_MEMORY_PROBE_PAD_VIDEO_SHIFT=0
endif

ifneq ($(filter 1,$(SATURN_PLATFORM_SKIP_INIT_PROBE)),)
CPPFLAGS += -DSATURN_PROBE_SKIP_INIT=1
else
CPPFLAGS += -DSATURN_PROBE_SKIP_INIT=0
endif

ifneq ($(filter 1,$(SATURN_PLATFORM_SKIP_PREPARE_PROBE)),)
CPPFLAGS += -DSATURN_PROBE_SKIP_PREPARE=1
else
CPPFLAGS += -DSATURN_PROBE_SKIP_PREPARE=0
endif

CC1FLAGS := -W -Wall -Wshadow -Wbad-function-cast -Winline -Wcomment \
	-Wsign-compare -Wextra -Wno-strict-aliasing -Wno-unused-value \
	-fno-common -ffast-math --param max-inline-insns-single=50 \
	-fms-extensions -std=gnu99 -fmerge-all-constants -fno-ident \
	-fno-unwind-tables -fno-asynchronous-unwind-tables \
	-fomit-frame-pointer -fstrength-reduce -frerun-loop-opt \
	-O2 -nodefaultlibs -nostdlib -fno-builtin -m2 -x c -S

CXXFLAGS := $(CC1FLAGS) -x c++ -fno-rtti -fno-exceptions -fno-threadsafe-statics -std=gnu++11
ASFLAGS := -m2 -c

LDFLAGS := -m2 \
	-L$(JOENGINE_SGL_LIB) \
	-Xlinker -T$(LINKER_SCRIPT) \
	-Xlinker -Map -Xlinker $(MAP) \
	-Xlinker -e -Xlinker ___Start \
	-nostartfiles

SYSOBJS := $(JOENGINE_SGL_LIB)/SGLAREA.O
LIBS := $(JOENGINE_SGL_LIB)/SEGA_SYS.A \
	$(JOENGINE_SGL_LIB)/LIBCD.A \
	$(JOENGINE_SGL_LIB)/LIBSGL.A \
	$(JOENGINE_SGL_LIB)/LIBCPK.A \
	$(JOENGINE_SGL_LIB)/LIBSND.A \
	-L$(JOENGINE_COMPILER)/LINUX/lib/gcc/sh-none-elf/8.2.0 \
	-lgcc

ifneq ($(SATURN_PLATFORM_MEMORY_PROBE),)
LIBAGB_SYSCALLS :=
else ifneq ($(filter 1,$(SATURN_MINIMAL_BOOT) $(SATURN_PLATFORM_PROBE) $(SATURN_ENTRY_PROBE) $(SATURN_PLATFORM_INIT_PROBE) $(SATURN_PLATFORM_ONLY_PROBE) $(SATURN_PLATFORM_CALLBACK_PROBE) $(SATURN_PLATFORM_VBLANK_PROBE) $(SATURN_PLATFORM_SPRITE_PROBE) $(SATURN_PLATFORM_STATIC_SPRITE_PROBE) $(SATURN_PLATFORM_SKIP_INIT_PROBE) $(SATURN_PLATFORM_SKIP_PREPARE_PROBE) $(SATURN_PLATFORM_SLIM_PROBE) $(SATURN_STAGE1_LOADER)),)
LIBAGB_SYSCALLS :=
else
LIBAGB_SYSCALLS := IntrWait \
	RegisterRamReset \
	Mod \
	HuffUnComp \
	SoftResetExram \
	DivArm \
	ModArm \
	Diff8bitUnFilterWram \
	MultiBoot \
	Div \
	Diff8bitUnFilterVram \
	SoftResetRom \
	BitUnPack \
	CpuFastSet \
	CpuSet \
	Diff16bitUnFilter \
	SoftReset
endif

TOOLDIRS := $(filter-out tools/agbcc/ tools/BriBaSA_ex/, $(dir $(wildcard tools/*/Makefile)))

OBJ_TILES_4BPP_SUBDIR := graphics/sa2/obj_tiles/4bpp
TILESETS_SUBDIR := graphics/sa2/tilesets
DATA_ASM_SUBDIR := data/sa2
DATA_ASM_BUILDDIR := $(OBJ_DIR)/$(DATA_ASM_SUBDIR)
SONG_SUBDIR := sound/sa2/songs
SONG_BUILDDIR := $(OBJ_DIR)/$(SONG_SUBDIR)
MID_SUBDIR := sound/sa2/songs/midi
MID_BUILDDIR := $(OBJ_DIR)/$(MID_SUBDIR)

ifneq ($(SATURN_PLATFORM_MEMORY_PROBE),)
LOCAL_C_SRCS := \
	src/platform/saturn/main.c \
	src/platform/saturn/platform.c \
	src/platform/saturn/platform_memory_probe.c
LOCAL_CXX_SRCS :=
DATA_ASM_SRCS :=
else ifeq ($(SATURN_STAGE2_ONLY),1)
ifeq ($(SATURN_STAGE2_PROFILE),probe)
LOCAL_C_SRCS := src/platform/saturn/stage2_game_probe.c
LOCAL_CXX_SRCS :=
DATA_ASM_SRCS :=
else ifeq ($(SATURN_STAGE2_PROFILE),shell)
LOCAL_C_SRCS := $(shell find src -name "*.c" -not -path "*/platform/win32/*" -not -path "*/platform/pret_sdl/*" -not -path "*/platform/ps2/*")
LOCAL_C_SRCS := $(filter-out \
	src/main.c \
	src/platform/saturn/bss_guard.c \
	src/platform/saturn/entry_probe_runtime.c \
	src/platform/saturn/full_link_probe.c \
	src/platform/saturn/minimal_main.c \
	src/platform/saturn/platform_callback_probe.c \
	src/platform/saturn/platform_init_probe.c \
	src/platform/saturn/platform_memory_probe.c \
	src/platform/saturn/platform_only_probe.c \
	src/platform/saturn/platform_probe.c \
	src/platform/saturn/platform_slim_probe.c \
	src/platform/saturn/platform_sprite_probe.c \
	src/platform/saturn/platform_static_sprite_probe.c \
	src/platform/saturn/platform_vblank_probe.c \
	src/platform/saturn/game_payload_shims.c \
	src/platform/saturn/stage2_probe_main.c \
	src/lib/m4a/m4a.c \
	src/lib/m4a/m4a_tables.c \
	src/platform/shared/audio/cgb_audio.c \
	src/platform/shared/audio/m4a_sound_mixer.c, \
	$(LOCAL_C_SRCS))
LOCAL_C_SRCS += src/platform/saturn/bss_guard.c src/platform/saturn/stage2_game_probe.c
LOCAL_C_SRCS := $(filter-out $(shell find src/game/sa2 -name "*.c"),$(LOCAL_C_SRCS))
LOCAL_C_SRCS := $(filter-out $(shell find src/data/sa2 -name "*.c"),$(LOCAL_C_SRCS))
LOCAL_C_SRCS := $(filter-out $(shell find src/game/shared/stage -name "*.c"),$(LOCAL_C_SRCS))
LOCAL_C_SRCS := $(filter-out $(shell find src/game/shared/multiplayer -name "*.c"),$(LOCAL_C_SRCS))
LOCAL_C_SRCS := $(filter-out $(shell find src/game/shared/collect_rings -name "*.c"),$(LOCAL_C_SRCS))
LOCAL_C_SRCS := $(filter-out $(shell find src/game/shared/menus -name "*.c"),$(LOCAL_C_SRCS))
LOCAL_C_SRCS := $(filter-out src/game/decomp_credits.c,$(LOCAL_C_SRCS))
LOCAL_CXX_SRCS := $(shell find src -name "*.cc")
DATA_ASM_SRCS := $(filter-out $(wildcard $(DATA_ASM_SUBDIR)/*.s),$(filter-out $(DATA_ASM_SUBDIR)/sound_data.s,$(wildcard $(DATA_ASM_SUBDIR)/*.s)))
else ifeq ($(SATURN_STAGE2_PROFILE),engine-init)
LOCAL_C_SRCS := $(shell find src -name "*.c" -not -path "*/platform/win32/*" -not -path "*/platform/pret_sdl/*" -not -path "*/platform/ps2/*")
