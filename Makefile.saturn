	$(JOENGINE_SRC)/image.c \
	$(JOENGINE_SRC)/vdp2.c \
	$(JOENGINE_SRC)/time.c \
	$(JOENGINE_SRC)/vdp1_command_pipeline.c \
	$(JOENGINE_SRC)/vdp2_malloc.c \
	$(JOENGINE_SRC)/3d.c
SONG_SRCS :=
MID_SRCS :=

LOCAL_OBJS := $(patsubst %.c,$(OBJ_DIR)/%.o,$(LOCAL_C_SRCS))
LOCAL_CXX_OBJS := $(patsubst %.cc,$(OBJ_DIR)/%.o,$(LOCAL_CXX_SRCS))
JOENGINE_OBJS := $(patsubst $(JOENGINE_ROOT)/%.c,$(OBJ_DIR)/joengine/%.o,$(JOENGINE_C_SRCS))
LIBAGB_OBJS := $(foreach syscall,$(LIBAGB_SYSCALLS),$(OBJ_DIR)/libagbsyscall/$(syscall).o)
DATA_ASM_OBJS := $(patsubst $(DATA_ASM_SUBDIR)/%.s,$(DATA_ASM_BUILDDIR)/%.o,$(DATA_ASM_SRCS))
SONG_OBJS := $(patsubst $(SONG_SUBDIR)/%.s,$(SONG_BUILDDIR)/%.o,$(SONG_SRCS))
MID_OBJS := $(patsubst $(MID_SUBDIR)/%.mid,$(MID_BUILDDIR)/%.o,$(MID_SRCS))
OBJS := $(LOCAL_OBJS) $(LOCAL_CXX_OBJS) $(JOENGINE_OBJS) $(LIBAGB_OBJS) $(DATA_ASM_OBJS) $(SONG_OBJS) $(MID_OBJS)
C_DEPS := $(patsubst %.c,$(OBJ_DIR)/%.d,$(LOCAL_C_SRCS))
CXX_DEPS := $(patsubst %.cc,$(OBJ_DIR)/%.d,$(LOCAL_CXX_SRCS))
JOENGINE_DEPS := $(patsubst $(JOENGINE_ROOT)/%.c,$(OBJ_DIR)/joengine/%.d,$(JOENGINE_C_SRCS))
DATA_ASM_DEPS := $(patsubst $(DATA_ASM_SUBDIR)/%.s,$(DATA_ASM_BUILDDIR)/%.d,$(DATA_ASM_SRCS))
SONG_DEPS := $(patsubst $(SONG_SUBDIR)/%.s,$(SONG_BUILDDIR)/%.d,$(SONG_SRCS))

.PHONY: all clean run tools $(TOOLDIRS)

ifeq ($(SATURN_STAGE2_ONLY),1)
all: tools $(RAW)
	@echo "NOTE: $(BUILD_NAME) is a staged payload image, not a standalone Saturn boot disc."
	@echo "NOTE: Use the default bootable cue under build/saturn/sa2-full-link-probe-minus-content-core/ for disc boot testing."
else
all: tools $(ENTRY) $(ISO) $(CUE)
endif

include graphics.mk

ifneq ($(NODEP),1)
-include $(C_DEPS)
-include $(CXX_DEPS)
-include $(JOENGINE_DEPS)
-include $(DATA_ASM_DEPS)
-include $(SONG_DEPS)
endif

%.s: ;
%.png: ;
%.pal: ;

%.1bpp: %.png ; $(GFX) $< $@
%.4bpp: %.png ; $(GFX) $< $@
%.8bpp: %.png ; $(GFX) $< $@
%.gbapal: %.pal ; $(GFX) $< $@
%.gbapal: %.png ; $(GFX) $< $@

%interactables.bin: %interactables.csv
	$(ENT_POS) $< $@ -entities INTERACTABLES -header "./include/constants/interactables.h"

%itemboxes.bin: %itemboxes.csv
	$(ENT_POS) $< $@ -entities ITEMS -header "./include/constants/items.h"

%enemies.bin: %enemies.csv
	$(ENT_POS) $< $@ -entities ENEMIES -header "./include/constants/enemies.h"

%rings.bin: %rings.csv
	$(ENT_POS) $< $@ -entities RINGS

%.gba.lz: %.gba
	$(GFX) $< $@

%.bin.lz: %.bin
	$(GFX) $< $@

%.lz: %
	$(GFX) $< $@

%.rl: %
	$(GFX) $< $@

%.bin: %.aif
	$(AIF) $< $@

$(TARGET): $(OBJS)
	@mkdir -p $(OUT_DIR)
	$(CC) $(LDFLAGS) $(SYSOBJS) $(OBJS) $(LIBS) -o $@

$(RAW): $(TARGET)
	$(OBJCOPY) -O binary $< $@
	@raw_size=$$(wc -c < "$@"); \
	if [ "$(SATURN_STAGE2_ONLY)" != "1" ] && [ $$raw_size -gt $(SATURN_BOOT_RAW_MAX_BYTES) ]; then \
		echo "ERROR: $@ is $$raw_size bytes, which is too large for the current Saturn first-stage boot path." >&2; \
		echo "Hint: keep the boot image small (the default uses SATURN_FULL_LINK_PROBE_EXCLUDE=content-core) or add staged CD loading." >&2; \
		exit 1; \
	fi

$(IPFILE):
	@mkdir -p $(DISC_DIR)
	cp $(JOENGINE_COMPILER)/COMMON/IP.BIN $(IPFILE)

$(ENTRY): $(RAW) $(IPFILE)
	cp $(RAW) $(ENTRY)

$(CD_ENTRY): $(RAW)
	@mkdir -p $(CD_DIR)
	cp $(RAW) $@

$(ABSFILE):
	@mkdir -p $(CD_DIR)
	printf 'NOT Abstracted by SEGA\n' > $@

$(BIBFILE):
	@mkdir -p $(CD_DIR)
	printf 'NOT Bibliographiced by SEGA\n' > $@

$(CPYFILE):
	@mkdir -p $(CD_DIR)
	: > $@

ifeq ($(SATURN_STAGE2_ONLY),0)
$(SATURN_STAGE2_RAW):
	$(MAKE) -f Makefile.saturn SATURN_STAGE2_ONLY=1 SATURN_STAGE1_LOADER=0 SATURN_BOOTABLE_DEFAULT=0 SATURN_STAGE2_PROFILE=shell SATURN_STAGE2_SHELL=1

$(SATURN_STAGE2_GAME_RAW):
	$(MAKE) -f Makefile.saturn SATURN_STAGE2_ONLY=1 SATURN_STAGE1_LOADER=0 SATURN_BOOTABLE_DEFAULT=0 SATURN_STAGE2_GAME_ONLY=1 SATURN_STAGE2_PROFILE=game-content SATURN_STAGE2_FILE=$(SATURN_STAGE2_GAME_FILE) SATURN_STAGE2_LOAD_ADDRESS=$(SATURN_STAGE2_GAME_LOAD_ADDRESS) SATURN_STAGE2_SHELL=0

$(SATURN_STAGE2_CD_FILE): $(SATURN_STAGE2_RAW)
	@mkdir -p $(CD_DIR)
	cp $(SATURN_STAGE2_RAW) $@

$(SATURN_STAGE2_GAME_CD_FILE): $(SATURN_STAGE2_GAME_RAW)
	@mkdir -p $(CD_DIR)
	cp $(SATURN_STAGE2_GAME_RAW) $@
endif

$(ISO): $(CD_ENTRY) $(ABSFILE) $(BIBFILE) $(CPYFILE) $(IPFILE) $(EXTRA_CD_FILES)
	cd "$(OUT_DIR)" && $(MKISOFS) $(MKISOFS_FLAGS)

$(CUE): $(ISO)
	cd "$(OUT_DIR)" && $(CUE_MAKER)

run: $(CUE)
	yabause -a -i "$(CUE)"

tools:
	@$(MAKE) -f Makefile tools NODEP=1

$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CPP) $(CPPFLAGS) $< -o $(OBJ_DIR)/$*.i
	$(PREPROC) $(OBJ_DIR)/$*.i $(PLATFORM) "" | $(CC) $(CC1FLAGS) -o $(OBJ_DIR)/$*.s -
	$(CC) $(ASFLAGS) $(OBJ_DIR)/$*.s -o $@

$(OBJ_DIR)/%.d: %.c
	@mkdir -p $(dir $@)
	$(SCANINC) -M $@ $(INCLUDE_SCANINC_ARGS) $<

$(OBJ_DIR)/%.o: %.cc
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -o $(OBJ_DIR)/$*.s $<
	$(CC) $(ASFLAGS) $(OBJ_DIR)/$*.s -o $@

$(OBJ_DIR)/%.d: %.cc
	@mkdir -p $(dir $@)
	$(SCANINC) -M $@ $(INCLUDE_SCANINC_ARGS) $<

$(OBJ_DIR)/joengine/%.o: $(JOENGINE_ROOT)/%.c
	@mkdir -p $(dir $@)
	$(CPP) $(CPPFLAGS) $< -o $(OBJ_DIR)/joengine/$*.i
	$(PREPROC) $(OBJ_DIR)/joengine/$*.i $(PLATFORM) "" | $(CC) $(CC1FLAGS) -o $(OBJ_DIR)/joengine/$*.s -
	$(CC) $(ASFLAGS) $(OBJ_DIR)/joengine/$*.s -o $@

$(OBJ_DIR)/joengine/%.d: $(JOENGINE_ROOT)/%.c
	@mkdir -p $(dir $@)
	$(SCANINC) -M $@ $(INCLUDE_SCANINC_ARGS) $<

$(OBJ_DIR)/libagbsyscall/%.o: libagbsyscall/libagbsyscall.c
	@mkdir -p $(dir $@)
	$(CPP) $(CPPFLAGS) -D L_$(*F)=1 $< -o $(OBJ_DIR)/libagbsyscall/$*.i
	$(PREPROC) $(OBJ_DIR)/libagbsyscall/$*.i $(PLATFORM) "" | $(CC) $(CC1FLAGS) -o $(OBJ_DIR)/libagbsyscall/$*.s -
	$(CC) $(ASFLAGS) $(OBJ_DIR)/libagbsyscall/$*.s -o $@

$(DATA_ASM_BUILDDIR)/%.o: $(DATA_ASM_SUBDIR)/%.s
	@mkdir -p $(dir $@)
	$(PREPROC) $< $(PLATFORM) "" | $(CPP) $(CPPFLAGS) - | $(CC) -m2 -x assembler-with-cpp -c -o $@ -

$(DATA_ASM_BUILDDIR)/%.d: $(DATA_ASM_SUBDIR)/%.s
	@mkdir -p $(dir $@)
	$(SCANINC) -M $@ $(INCLUDE_SCANINC_ARGS) $<

$(SONG_BUILDDIR)/%.o: $(SONG_SUBDIR)/%.s
	@mkdir -p $(dir $@)
	$(PREPROC) $< $(PLATFORM) "" | $(CPP) $(CPPFLAGS) - | $(CC) -m2 -x assembler-with-cpp -c -o $@ -

$(SONG_BUILDDIR)/%.d: $(SONG_SUBDIR)/%.s
	@mkdir -p $(dir $@)
	$(SCANINC) -M $@ $(INCLUDE_SCANINC_ARGS) $<

$(MID_BUILDDIR)/%.o: $(MID_SUBDIR)/%.s
	@mkdir -p $(dir $@)
	$(PREPROC) $< $(PLATFORM) "" | $(CPP) $(CPPFLAGS) - | $(CC) -m2 -x assembler-with-cpp -c -o $@ -

chao_garden/mb_chao_garden.gba:
	@printf "1" > $@

multi_boot/subgame_bootstrap/subgame_bootstrap.gba:
	@printf "1" > $@

multi_boot/programs/subgame_loader/subgame_loader.bin:
	@printf "1" > $@

multi_boot/collect_rings/mb_signed_collect_rings.gba:
	@printf "1" > $@

clean: tidy
	rm -rf build/saturn

tidy:
	$(RM) $(MID_SUBDIR)/*.s
	find . \( -iwholename './data/*/maps/*/*/entities/*.bin' -o -iname '*.1bpp' -o -iname '*.4bpp' -o -iname '*.8bpp' -o -iname '*.gbapal' -o -iname '*.lz' -o -iname '*.rl' -o -iname '*.latfont' -o -iname '*.hwjpnfont' -o -iname '*.fwjpnfont' \) -exec $(RM) {} +
